LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 单元06 向量化：本地中文模型目录（约 180MB，不提交到仓库）。
# 留空则默认读取项目根目录下的 models/。
# 换电脑时把它指向课程材料里的 models/ 文件夹，例如：
# EMBEDDING_MODEL_DIR=D:/pycharm/Agent/unit6/06-Embedding与向量化/models
EMBEDDING_MODEL_DIR=

# 单元11 重排：本地 BGE Cross-Encoder 目录（模型权重 1.1GB，不提交到仓库）。
# 留空则默认读取项目根目录下的 models/bge-reranker-base。
# 换电脑时把它指向课程材料里存放 bge-reranker-base 的文件夹，例如：
# RERANK_MODEL_DIR=D:/pycharm/Agent/unit11/11-RAG优化/models
RERANK_MODEL_DIR=

# 各单元数据库目录都留了覆盖开关，默认各自落在项目根目录下的 .chroma_unitN/：
# CHROMA_DB_DIR（单元08）、CHROMA_UNIT9_DB_DIR、CHROMA_UNIT10_DB_DIR、
# CHROMA_UNIT11_DB_DIR、CHROMA_UNIT12_DB_DIR（单元12 多格式资料库）。
# 一般不用改；需要把库临时切到别的目录时再设。
CHROMA_UNIT12_DB_DIR=
